# Binaries
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, build with `go test -c`
*.test

# Output of the go coverage tool
*.out

# Go workspace file
go.work
go.work.sum

# Build output
/bin/
/dist/

# ExecDB-generated artifacts: snapshot binaries have no fixed name/extension
# (see execdb_spec.md §4/§9), and self-overwrite leaves a transient sidecar
# file (see execdb_spec.md §7) if the process is killed mid-cleanup.
*.execdb_old
/execdb_poc

# execdb-drivers: a separate git repository (github.com/amisonnet8/
# execdb-drivers) that may be cloned into this directory for local
# convenience (multi-language pgwire driver checks). Not part of this
# repo's history -- see .claude/rules/testing.md.
/execdb-drivers/
